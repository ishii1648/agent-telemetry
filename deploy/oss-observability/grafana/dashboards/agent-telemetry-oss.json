        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "oss-loki" },
          "expr": "{service_name=\"agent-telemetry\"}",
          "refId": "A"
        }
      ]
    }
  ],
