    {
      "id": 6,
      "title": "Raw events (Loki / OTLP Logs)",
      "description": "OTel Collector 経由で Loki に流れた raw events（OTLP Logs）。PR 集約 gauge では追えない個々のイベントを LogQL でドリルダウンする",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "loki", "uid": "oss-loki" },
      "options": {
