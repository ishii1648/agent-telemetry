        "text": { "valueSize": 30 },
        "legend": { "showLegend": false }
      }
    },
    {
      "id": 15,
      "title": "PR 別 tokens / tool_use",
      "description": "1 tool_use あたりの token 消費が大きい PR。ファイル肥大・無駄な再読みの兆候。上位 5 件のみ",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "oss-mimir" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "oss-mimir" },
          "expr": "topk(5, last_over_time(agent_pr_tokens_per_tool_use{coding_agent=~\"$coding_agent\"}[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "coding_agent": true,
              "user_id": true,
              "model": true,
              "task_type": true
            },
            "renameByName": { "Value": "tokens_per_tool_use" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#dc2626", "mode": "fixed" },
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "xField": "pr_url",
        "orientation": "horizontal",
        "showValue": "always",
        "barWidth": 0.6,
        "text": { "valueSize": 30 },
        "legend": { "showLegend": false }
      }
    },
    {
